# This is a template file showing which environment variables are used
# DO NOT put actual API keys here - they should be configured in Supabase Edge Functions

# Supabase Configuration (auto-configured by Lovable)
# These are public keys and can be committed to version control
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# API Keys (Configure these in Supabase Dashboard -> Settings -> Edge Functions)
# OPENWEATHER_API_KEY=your-key-here (Edge Function secret)
# NEWS_API_KEY=your-key-here (Edge Function secret)
# ALPHA_VANTAGE_API_KEY=your-key-here (Edge Function secret)
# GOOGLE_MAPS_API_KEY=your-key-here (Edge Function secret)
# LOVABLE_API_KEY=auto-configured (Edge Function secret)
